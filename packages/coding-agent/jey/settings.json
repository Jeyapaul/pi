{
  "defaultModel": "claude-opus-4-6",
  "defaultProvider": "anthropic",
  "lastChangelogVersion": "0.87.1",
  "packages": [
    "git:github.com/huggingface/pi-llama",
    "npm:pi-git-auth"
  ],
  "agentTeam": {
    "roles": {
      "research": { "model": "z-ai/glm-5.3-flash", "provider": "openrouter", "maxCostUsd": 0.5, "timeoutMin": 10 },
      "implement": { "model": "deepseek/deepseek-v4-pro", "provider": "openrouter", "maxCostUsd": 2.0, "timeoutMin": 30 }
    },
    "advisor": { "failOpen": true, "model": "jev-latest" }
  },
  "theme": "dark",
  "tuiMode": "fullscreen",
  "retry": {
    "maxRetries": 5,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 3,
      "maxRetryDelayMs": 0
    }
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true
}