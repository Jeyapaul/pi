#!/usr/bin/env node
/**
 * pi-resume — interactive session picker for pi.
 * Lists sessions (named + unnamed) ordered by last use; ↑/↓ navigate, Enter opens.
 * Invoked by the zsh pi() wrapper on `pi -r` / `pi --resume`.
 */
const { execFileSync, spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const PI_SESSIONS = path.join(os.homedir(), ".pi/agent/bin/pi-sessions");

function listSessions() {
	let raw;
	try {
		raw = spawnSync("node", [PI_SESSIONS, "--json"], { encoding: "utf8", maxBuffer: 16 * 1024 * 1024 });
	} catch {
		console.error("pi-sessions not found at", PI_SESSIONS);
		process.exit(1);
	}
	if (raw.status !== 0 || !raw.stdout) {
		console.error("pi-sessions failed:", (raw.stderr || "").slice(0, 300));
		process.exit(1);
	}
	const sessions = JSON.parse(raw.stdout);
	// hide ephemeral runtime/process sessions (temp-dir cwds) — same rule as pi-sessions default
	const visible = sessions.filter((s) => !/\/var\/folders\/|\/private\/tmp\/|\/tmp\//.test(s.cwd));
	visible.sort((a, b) => Number(b.mtime) - Number(a.mtime)); // last use first
	return visible;
}

function fmtAge(ms) {
	const diff = Date.now() - Number(ms);
	const m = Math.floor(diff / 60000);
	if (m < 1) return "now";
	if (m < 60) return `${m}m`;
	const h = Math.floor(m / 60);
	if (h < 24) return `${h}h`;
	const d = Math.floor(h / 24);
	return d < 30 ? `${d}d` : `${Math.floor(d / 30)}mo`;
}

const C = { dim: "\x1b[2m", accent: "\x1b[36m", bold: "\x1b[1m", reset: "\x1b[0m", sel: "\x1b[7m" };

function render(rows, sel, msg) {
	const out = [];
	out.push(`${C.bold}Resume a pi session${C.reset}  ${C.dim}(↑/↓ or j/k · Enter open · q quit)${C.reset}`);
	if (msg) out.push(msg);
	const H = Math.min(rows.length, Math.max(10, process.stdout.rows ? process.stdout.rows - 4 : 20));
	const start = Math.max(0, Math.min(sel - Math.floor(H / 2), rows.length - H));
	for (let i = start; i < Math.min(start + H, rows.length); i++) {
		const s = rows[i];
		const tag = /^agent-(research|implement)-/.test(s.id) ? `${C.accent}[agent]${C.reset} ` : "";
		const name = s.name || `${C.dim}(unnamed)${C.reset}`;
		const line = ` ${name}  ${C.dim}${s.msgs} msgs · $${Number(s.cost).toFixed(2)} · ${fmtAge(s.mtime)}${C.reset}`;
		out.push(i === sel ? `${C.sel}${line}${C.reset}` : line);
	}
	if (rows.length > H) out.push(C.dim + `  … ${rows.length - start - H} more below` + C.reset);
	return out;
}

function main() {
	const rows = listSessions();
	if (rows.length === 0) {
		console.log("No pi sessions found.");
		process.exit(0);
	}
	if (!process.stdin.isTTY) {
		// non-interactive: print the list, no picker
		for (const s of rows.slice(0, 30)) console.log(`${s.name || "(unnamed)"}\t${s.id}\t${fmtAge(s.mtime)}`);
		process.exit(0);
	}
	const stdin = process.stdin;
	stdin.setRawMode(true);
	stdin.resume();
	let sel = 0;
	let msg = "";
	let lastDrawn = -1;
	const draw = (force) => {
		if (!force && lastDrawn === sel) return;
		lastDrawn = sel;
		process.stdout.write("\x1b[H\x1b[2J" + render(rows, sel, msg).join("\n") + "\n");
		msg = "";
	};
	draw(true);
	stdin.on("data", (buf) => {
		const ch = buf.toString();
		if (ch === "\x03" || ch === "q" || ch === "\x1b") {
			// esc alone quits; escape sequences (\x1b[A) navigate
			if (ch === "\x1b" && buf.length === 1) {
				stdin.setRawMode(false);
				process.exit(0);
			}
			if (ch === "\x03") {
				stdin.setRawMode(false);
				process.exit(0);
			}
		}
		if (ch === "\x1b[A" || ch === "k") {
			sel = Math.max(0, sel - 1);
			draw();
			return;
		}
		if (ch === "\x1b[B" || ch === "j") {
			sel = Math.min(rows.length - 1, sel + 1);
			draw();
			return;
		}
		if (ch === "\r" || ch === "\n") {
			stdin.setRawMode(false);
			const s = rows[sel];
			console.log(`Resuming: ${s.name || s.id}`);
			// hand off to pi — replace this process
			try {
				const r = spawnSync("pi", ["--session", s.id], { stdio: "inherit" });
				process.exit(r.status ?? 0);
			} catch (e) {
				console.error("Failed to launch pi:", e.message);
				process.exit(1);
			}
		}
		draw();
	});
}

main();